<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/content" android:layout_width="match_parent"
        android:layout_height="match_parent" android:orientation="vertical">
        <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            app:title="@string/system_ui_title" app:navigationIcon="@drawable/native_catalog_back"
            app:navigationContentDescription="@string/go_back" />
        <ScrollView android:id="@+id/scroll" android:layout_width="match_parent"
            android:layout_height="@dimen/template_zero" android:layout_weight="1"
            android:fillViewport="true" android:clipToPadding="false">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:padding="@dimen/template_gap" android:orientation="vertical"
                android:focusableInTouchMode="true" android:descendantFocusability="beforeDescendants">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginBottom="@dimen/template_gap" android:padding="@dimen/template_gap" android:background="@drawable/native_catalog_search">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_preview_title" android:textSize="@dimen/native_catalog_name_size" android:textColor="@color/color_main_title" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_intro" android:textSize="@dimen/native_catalog_section_size" android:textColor="@color/color_sub_title" />
<TextView android:id="@+id/actual_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_state_pending" android:textSize="@dimen/native_catalog_section_size" android:textColor="@color/color_sub_title" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_scope" android:textSize="@dimen/native_catalog_section_size" android:textColor="@color/color_sub_title" />
<com.google.android.material.button.MaterialButton android:id="@+id/immersive" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/system_ui_enter_immersive" android:textAllCaps="false" />
<com.google.android.material.button.MaterialButton android:id="@+id/show_bars" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/system_ui_show_bars" android:textAllCaps="false" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginBottom="@dimen/template_gap" android:padding="@dimen/template_gap" android:background="@drawable/native_catalog_search">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_bars_section" android:textSize="@dimen/native_catalog_name_size" android:textColor="@color/color_main_title" android:textStyle="bold" />
<androidx.appcompat.widget.SwitchCompat android:id="@+id/extend_background" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/listPreferredItemHeightSmall" android:text="@string/system_ui_background" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_background_hint" android:textSize="@dimen/native_catalog_section_size" android:textColor="@color/color_sub_title" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_status_color" android:textSize="@dimen/native_catalog_section_size" android:textColor="@color/color_sub_title" />
<Spinner android:id="@+id/status_color" android:layout_width="match_parent" android:layout_height="@dimen/native_catalog_search_height" android:entries="@array/system_ui_color_names" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_navigation_color" android:textSize="@dimen/native_catalog_section_size" android:textColor="@color/color_sub_title" />
<Spinner android:id="@+id/navigation_color" android:layout_width="match_parent" android:layout_height="@dimen/native_catalog_search_height" android:entries="@array/system_ui_color_names" />
<androidx.appcompat.widget.SwitchCompat android:id="@+id/hide_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/listPreferredItemHeightSmall" android:text="@string/system_ui_hide_status" />
<androidx.appcompat.widget.SwitchCompat android:id="@+id/hide_navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/listPreferredItemHeightSmall" android:text="@string/system_ui_hide_navigation" />
<androidx.appcompat.widget.SwitchCompat android:id="@+id/auto_icons" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/listPreferredItemHeightSmall" android:text="@string/system_ui_auto_icons" />
<androidx.appcompat.widget.SwitchCompat android:id="@+id/dark_status_icons" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/listPreferredItemHeightSmall" android:text="@string/system_ui_dark_status_icons" />
<androidx.appcompat.widget.SwitchCompat android:id="@+id/dark_navigation_icons" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/listPreferredItemHeightSmall" android:text="@string/system_ui_dark_navigation_icons" />
<TextView android:id="@+id/navigation_support" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_nav_icons_unsupported" android:textSize="@dimen/native_catalog_section_size" android:textColor="@color/color_sub_title" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_platform_hint" android:textSize="@dimen/native_catalog_section_size" android:textColor="@color/color_sub_title" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginBottom="@dimen/template_gap" android:padding="@dimen/template_gap" android:background="@drawable/native_catalog_search">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_screen_section" android:textSize="@dimen/native_catalog_name_size" android:textColor="@color/color_main_title" android:textStyle="bold" />
<androidx.appcompat.widget.SwitchCompat android:id="@+id/keep_awake" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/listPreferredItemHeightSmall" android:text="@string/system_ui_keep_awake" />
<androidx.appcompat.widget.SwitchCompat android:id="@+id/follow_brightness" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/listPreferredItemHeightSmall" android:text="@string/system_ui_follow_brightness" />
<TextView android:id="@+id/brightness_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_brightness_system" android:textSize="@dimen/native_catalog_section_size" android:textColor="@color/color_sub_title" />
<SeekBar android:id="@+id/brightness" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progress="50" android:contentDescription="@string/system_ui_screen_section" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_screen_hint" android:textSize="@dimen/native_catalog_section_size" android:textColor="@color/color_sub_title" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginBottom="@dimen/template_gap" android:padding="@dimen/template_gap" android:background="@drawable/native_catalog_search">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_keyboard_section" android:textSize="@dimen/native_catalog_name_size" android:textColor="@color/color_main_title" android:textStyle="bold" />
<EditText android:id="@+id/keyboard_input" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:hint="@string/system_ui_input_hint" android:inputType="text" android:maxLines="2" android:importantForAutofill="no" />
<com.google.android.material.button.MaterialButton android:id="@+id/show_keyboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/system_ui_show_keyboard" android:textAllCaps="false" />
<com.google.android.material.button.MaterialButton android:id="@+id/hide_keyboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/system_ui_hide_keyboard" android:textAllCaps="false" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginBottom="@dimen/template_gap" android:padding="@dimen/template_gap" android:background="@drawable/native_catalog_search">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_settings_section" android:textSize="@dimen/native_catalog_name_size" android:textColor="@color/color_main_title" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/system_ui_settings_hint" android:textSize="@dimen/native_catalog_section_size" android:textColor="@color/color_sub_title" />
<com.google.android.material.button.MaterialButton android:id="@+id/display_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/system_ui_display_settings" android:textAllCaps="false" />
<com.google.android.material.button.MaterialButton android:id="@+id/app_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/system_ui_app_settings" android:textAllCaps="false" />
<com.google.android.material.button.MaterialButton android:id="@+id/notification_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/system_ui_notification_settings" android:textAllCaps="false" />
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/reset" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/system_ui_reset" android:textAllCaps="false" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <dev.androidbasekit.sample.view.widget.SystemBarBackdropView android:id="@+id/bar_backdrop"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" android:clickable="false" android:focusable="false" />
</FrameLayout>
