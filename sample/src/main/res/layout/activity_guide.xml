<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center"
        android:padding="@dimen/template_spacing">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/template_guide_title" android:gravity="center"
            android:textSize="@dimen/template_title_size" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_gap" android:gravity="center"
            android:text="@string/template_guide_body" android:textSize="@dimen/template_body_size" />
        <com.google.android.material.button.MaterialButton android:id="@+id/start_button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_spacing" android:text="@string/template_start" />
    </LinearLayout>
</ScrollView>
