<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/demo_details_title" app:navigationIcon="@drawable/native_catalog_back" app:navigationContentDescription="@string/go_back" />
    <ScrollView android:layout_width="match_parent" android:layout_height="@dimen/template_zero" android:layout_weight="1" android:fillViewport="true" android:padding="@dimen/template_gap" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/native_catalog_search" android:padding="@dimen/template_gap" android:layout_marginBottom="@dimen/template_gap">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_details_caption" android:textColor="@color/color_main_title" android:textSize="@dimen/native_catalog_name_size" android:textStyle="bold" android:freezesText="true" />
