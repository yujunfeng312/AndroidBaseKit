            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/template_gap" android:textSize="@dimen/native_catalog_name_size" android:textStyle="bold" android:textColor="@color/color_main_title" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
