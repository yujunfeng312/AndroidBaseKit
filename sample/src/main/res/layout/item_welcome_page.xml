<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center" android:padding="@dimen/template_spacing">
        <ImageView android:id="@+id/illustration" android:layout_width="match_parent"
            android:layout_height="@dimen/template_welcome_image_height" android:scaleType="fitCenter"
            android:importantForAccessibility="no" />
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_gap" android:gravity="center"
            android:textSize="@dimen/template_title_size" android:textColor="@color/color_main_title" />
        <TextView android:id="@+id/body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/template_gap" android:gravity="center"
            android:textSize="@dimen/template_body_size" android:textColor="@color/color_sub_title" />
    </LinearLayout>
</ScrollView>
