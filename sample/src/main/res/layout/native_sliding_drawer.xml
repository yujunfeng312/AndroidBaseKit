<SlidingDrawer xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:handle="@+id/drawer_handle" android:content="@+id/drawer_content">
    <Button android:id="@id/drawer_handle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/native_drawer_handle" />
    <TextView android:id="@id/drawer_content" android:layout_width="match_parent"
        android:layout_height="match_parent" android:gravity="center"
        android:background="@color/color_info_background" android:textColor="@color/color_info"
        android:text="@string/native_drawer_content" />
</SlidingDrawer>
