<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:title="@string/hub_title" app:subtitle="@string/hub_subtitle" app:titleTextColor="@color/color_main_title" app:subtitleTextColor="@color/color_sub_title" />
    <com.google.android.material.tabs.TabLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/color_surface" app:tabMode="fixed" app:tabGravity="fill" />
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/view_pager" android:layout_width="match_parent"
        android:layout_height="@dimen/template_zero" android:layout_weight="1" />
</LinearLayout>
