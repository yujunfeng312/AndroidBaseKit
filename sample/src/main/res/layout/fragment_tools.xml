<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/template_gap" android:focusableInTouchMode="true" android:descendantFocusability="beforeDescendants">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/hub_tools_title" android:textColor="@color/color_main_title" android:textSize="@dimen/native_catalog_name_size" android:textStyle="bold" android:freezesText="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/hub_tools_body" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/native_catalog_search" android:padding="@dimen/template_gap" android:layout_marginBottom="@dimen/template_gap">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/tools_feedback_title" android:textColor="@color/color_main_title" android:textSize="@dimen/native_catalog_name_size" android:textStyle="bold" android:freezesText="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/tools_feedback_body" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/toast_button" android:layout_width="@dimen/template_zero" android:layout_height="wrap_content" android:text="@string/tools_toast" android:textAllCaps="false" android:layout_weight="1" android:layout_marginEnd="@dimen/native_catalog_gap_small" />
                <com.google.android.material.button.MaterialButton android:id="@+id/snackbar_button" android:layout_width="@dimen/template_zero" android:layout_height="wrap_content" android:text="@string/tools_snackbar" android:textAllCaps="false" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/dialog_button" android:layout_width="@dimen/template_zero" android:layout_height="wrap_content" android:text="@string/tools_dialog" android:textAllCaps="false" android:layout_weight="1" android:layout_marginEnd="@dimen/native_catalog_gap_small" />
                <com.google.android.material.button.MaterialButton android:id="@+id/loading_button" android:layout_width="@dimen/template_zero" android:layout_height="wrap_content" android:text="@string/tools_loading" android:textAllCaps="false" android:layout_weight="1" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/tools_loading_hint" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/native_catalog_search" android:padding="@dimen/template_gap" android:layout_marginBottom="@dimen/template_gap">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/tools_clipboard_title" android:textColor="@color/color_main_title" android:textSize="@dimen/native_catalog_name_size" android:textStyle="bold" android:freezesText="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/tools_clipboard_body" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
            <EditText android:id="@+id/clipboard_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/tools_clipboard_hint" android:text="@string/tools_clipboard_default" android:inputType="text" android:maxLength="200" android:importantForAutofill="no" />
            <com.google.android.material.button.MaterialButton android:id="@+id/copy_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tools_copy" android:textAllCaps="false" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/native_catalog_search" android:padding="@dimen/template_gap" android:layout_marginBottom="@dimen/template_gap">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/tools_format_title" android:textColor="@color/color_main_title" android:textSize="@dimen/native_catalog_name_size" android:textStyle="bold" android:freezesText="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/tools_format_body" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
            <EditText android:id="@+id/seconds_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/tools_seconds_hint" android:text="@string/tools_seconds_default" android:inputType="number" android:maxLength="15" android:importantForAutofill="no" />
            <EditText android:id="@+id/bytes_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/tools_bytes_hint" android:text="@string/tools_bytes_default" android:inputType="number" android:maxLength="15" android:importantForAutofill="no" />
            <com.google.android.material.button.MaterialButton android:id="@+id/format_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tools_format" android:textAllCaps="false" />
            <TextView android:id="@+id/format_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/tools_format_body" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/native_catalog_search" android:padding="@dimen/template_gap" android:layout_marginBottom="@dimen/template_gap">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/tools_cache_title" android:textColor="@color/color_main_title" android:textSize="@dimen/native_catalog_name_size" android:textStyle="bold" android:freezesText="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/tools_cache_body" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/cache_write" android:layout_width="@dimen/template_zero" android:layout_height="wrap_content" android:text="@string/tools_cache_write" android:textAllCaps="false" android:layout_weight="1" android:layout_marginEnd="@dimen/native_catalog_gap_small" />
                <com.google.android.material.button.MaterialButton android:id="@+id/cache_read" android:layout_width="@dimen/template_zero" android:layout_height="wrap_content" android:text="@string/tools_cache_read" android:textAllCaps="false" android:layout_weight="1" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/cache_clear" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tools_cache_clear" android:textAllCaps="false" />
            <TextView android:id="@+id/cache_result" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/tools_cache_empty" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
