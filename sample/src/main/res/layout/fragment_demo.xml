<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/demo_module_title" app:navigationIcon="@drawable/native_catalog_back" app:navigationContentDescription="@string/go_back" />
    <androidx.core.widget.NestedScrollView android:id="@+id/demo_scroll" android:layout_width="match_parent" android:layout_height="@dimen/template_zero" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/template_gap">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_module_intro" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/native_catalog_search" android:padding="@dimen/template_gap" android:layout_marginBottom="@dimen/template_gap">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_source_title" android:textColor="@color/color_main_title" android:textSize="@dimen/native_catalog_name_size" android:textStyle="bold" android:freezesText="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_source_body" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <dev.androidbasekit.ui.LoadingTextView android:id="@+id/local_button" android:layout_width="@dimen/template_zero" android:layout_height="@dimen/hub_action_height" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:gravity="center" android:background="@drawable/native_catalog_card" android:textColor="@color/color_primary" android:text="@string/demo_local_action" app:ltv_autoLoadingOnClick="false" android:layout_weight="1" android:layout_marginEnd="@dimen/native_catalog_gap_small" />
                    <dev.androidbasekit.ui.LoadingTextView android:id="@+id/network_button" android:layout_width="@dimen/template_zero" android:layout_height="@dimen/hub_action_height" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:gravity="center" android:background="@drawable/native_catalog_card" android:textColor="@color/color_primary" android:text="@string/demo_network_action" app:ltv_autoLoadingOnClick="false" android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/native_catalog_search" android:padding="@dimen/template_gap" android:layout_marginBottom="@dimen/template_gap">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_state_title" android:textColor="@color/color_main_title" android:textSize="@dimen/native_catalog_name_size" android:textStyle="bold" android:freezesText="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_state_body" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton android:id="@+id/empty_button" android:layout_width="@dimen/template_zero" android:layout_height="wrap_content" android:text="@string/demo_empty_action" android:textAllCaps="false" android:layout_weight="1" android:layout_marginEnd="@dimen/native_catalog_gap_small" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/error_button" android:layout_width="@dimen/template_zero" android:layout_height="wrap_content" android:text="@string/demo_error_action" android:textAllCaps="false" android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/native_catalog_search" android:padding="@dimen/template_gap" android:layout_marginBottom="@dimen/template_gap">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_result_title" android:textColor="@color/color_main_title" android:textSize="@dimen/native_catalog_name_size" android:textStyle="bold" android:freezesText="true" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_result_body" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
                <com.google.android.material.button.MaterialButton android:id="@+id/result_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/demo_result_action" android:textAllCaps="false" />
                <TextView android:id="@+id/result_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_result_idle" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_list_title" android:textColor="@color/color_main_title" android:textSize="@dimen/native_catalog_name_size" android:textStyle="bold" android:freezesText="true" />
            <TextView android:id="@+id/data_count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_list_title" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
            <TextView android:id="@+id/page_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/native_catalog_gap_small" android:text="@string/demo_status_loading" android:textColor="@color/color_sub_title" android:textSize="@dimen/native_catalog_section_size" android:freezesText="true" />
            <ProgressBar android:id="@+id/refresh_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="@dimen/hub_progress_height" android:indeterminate="true" android:visibility="gone" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="@dimen/hub_state_min_height">
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
                <dev.androidbasekit.ui.PageStateView android:id="@+id/page_state" android:layout_width="match_parent" android:layout_height="match_parent" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
